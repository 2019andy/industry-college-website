# ============================================================
# 生产环境变量配置
# 部署时复制为 .env 并填写真实值，切勿提交到 Git
# ============================================================

# JWT 密钥（必须修改！建议使用 32+ 位随机字符串）
# 生成方式：openssl rand -base64 32
JWT_SECRET=CHANGE_ME_TO_RANDOM_32_CHAR_STRING

# 管理员初始密码（首次启动后会在 content/auth.json 中生成密码哈希）
# 如需修改密码，请在后台管理 → 修改密码 中操作
ADMIN_DEFAULT_PASSWORD=admin123
